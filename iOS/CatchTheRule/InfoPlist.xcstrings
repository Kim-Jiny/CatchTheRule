{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catch the Rule"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙찾기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを探せ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现规律"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra la Regla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve le Motif"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde die Regel"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow tracking to show ads more relevant to you and keep the game free."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적을 허용하면 나에게 더 맞는 광고가 표시되고 게임을 무료로 유지할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラッキングを許可すると、あなたに合った広告が表示され、ゲームを無料で提供し続けられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许跟踪后，将为您展示更相关的广告，并让游戏保持免费。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el seguimiento para ver anuncios más relevantes y mantener el juego gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le suivi pour afficher des publicités plus pertinentes et garder le jeu gratuit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube das Tracking, um relevantere Werbung zu sehen und das Spiel kostenlos zu halten."
          }
        }
      }
    }
  },
  "version": "1.0"
}